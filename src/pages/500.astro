---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500 Server Error | CurrencieConv"
  description="An internal server error occurred on CurrencieConv online currency converter."
  currentPath="/500"
>
  <div class="py-16 sm:py-24 px-4 sm:px-6">
    <div class="container-app max-w-2xl mx-auto text-center">
      <!-- 500 Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-error-soft text-error font-mono text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
        Error 500
      </div>

      <!-- Heading -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary mb-4 tracking-tight">
        Internal Server Error
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-lg mx-auto mb-8 leading-relaxed">
        Something went wrong while processing your currency rate request. Don't worry, our system is automatically recovering.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/" class="btn-primary w-full sm:w-auto px-6 py-3 text-sm">
          Return to Currency Converter
        </a>
        <button onclick="window.location.reload()" class="btn-secondary w-full sm:w-auto px-6 py-3 text-sm">
          Reload Page
        </button>
      </div>

      <!-- Support Info -->
      <div class="p-6 bg-canvas-soft border border-hairline rounded-2xl dark:bg-slate-900 text-left">
        <h3 class="text-sm font-semibold text-primary uppercase font-mono tracking-wider mb-2">Need Immediate Help?</h3>
        <p class="text-xs text-mute mb-4">If this error continues, please let our technical support team know.</p>
        <div class="flex gap-4">
          <a href="/contact" class="text-xs font-semibold text-link hover:underline">Contact Support →</a>
          <a href="/rates" class="text-xs font-semibold text-link hover:underline">Check Live Rates →</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
