---
import Layout from '../layouts/Layout.astro';
import CurrencyConverter from '../components/CurrencyConverter.astro';

const schemaMarkup = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CurrencieConv - Currency Converter",
  "url": "https://www.currencieconv.com",
  "description": "Free online currency converter with real-time exchange rates. Convert USD to EUR, USD to INR, dollar to rupee, euro to dollar and 150+ world currencies instantly.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "Anuska Rani"
  },
  "creator": {
    "@type": "Person",
    "name": "Anuska Rani"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "2450",
    "bestRating": "5",
    "worstRating": "1"
  }
});
---

<Layout
  title="Currency Converter Online - Free Real-time Exchange Rates | CurrencieConv"
  description="Free online currency converter with live exchange rates. Convert USD to EUR, USD to INR, $ to INR, dollar to rupee, euro to dollar and 150+ currencies instantly. Accurate real-time currency converter calculator by Anuska Rani."
  keywords="currency converter, currency converter online, online currency converter, $ to inr, 1$ to inr, us$ to inr, $ to inr rate, usd to eur, usd to inr, dollar to rupee, euro to dollar, currency exchange rate, live currency converter, money converter online, forex converter, dollar to euro converter, currency converter calculator, real time currency converter, free currency converter, usd to gbp, inr to usd, currency conversion rates, best currency converter, currency converter live rates, accurate currency converter, world currency converter, foreign exchange converter, convert currency online free, currency rate today, international currency converter, usd to jpy converter, currency converter with live rates, online money exchange calculator"
  currentPath="/"
  schemaMarkup={schemaMarkup}
>
  <CurrencyConverter />

  <!-- Stripe-inspired Editorial Content Section -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 bg-[#f6f9fc] dark:bg-[#0b0d1b] border-t border-[#e3e8ee] dark:border-[#22284c]">
    <div class="container-app max-w-4xl mx-auto">
      <article class="space-y-12">
        
        <!-- Header -->
        <div>
          <span class="pill-tag-soft mb-3">Institutional Accuracy</span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-[300] tracking-[-0.96px] text-[#0d253d] dark:text-white leading-tight mb-5">
            Transparent exchange rates for global commerce and personal transfers.
          </h2>
          <p class="text-base sm:text-lg text-[#273951] dark:text-[#94a3b8] font-[300] leading-relaxed">
            CurrencieConv gives you the live interbank rate — the exact mid-point between buy and sell quotes on global forex exchanges. No inflated spreads, no hidden markup, and zero delay.
          </p>
        </div>

        <!-- Stripe Feature Grid with Cream Band Callout -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="stripe-card p-8 bg-white dark:bg-[#12162e]">
            <h3 class="text-xl font-[300] tracking-tight text-[#0d253d] dark:text-white mb-3">
              How Live Interbank Sync Works
            </h3>
            <p class="text-sm text-[#64748d] dark:text-[#94a3b8] font-light leading-relaxed">
              Our backend monitors active forex market hours across London, New York, Tokyo, and Singapore. Exchange rate ticks stream directly into your browser every 60 seconds, calculating sub-cent conversions with pure precision.
            </p>
          </div>

          <!-- Stripe Warm Cream Band Interlude -->
          <div class="card-cream-band p-8">
            <h3 class="text-xl font-[300] tracking-tight text-[#0d253d] mb-3">
              Fair Mid-Market Pricing Guarantee
            </h3>
            <p class="text-sm text-[#273951] font-light leading-relaxed">
              Banks and airports often conceal a 3% to 6% foreign exchange fee inside unfavorable rates. CurrencieConv displays the actual real-time benchmark so you always know your exact currency value.
            </p>
          </div>
        </div>

        <!-- Deep Dive Text for SEO -->
        <div class="stripe-card p-8 sm:p-10 bg-white dark:bg-[#12162e] space-y-6">
          <h3 class="text-2xl font-[300] tracking-tight text-[#0d253d] dark:text-white">
            Comprehensive Support for Over 150+ World Currencies
          </h3>
          <p class="text-sm sm:text-base text-[#273951] dark:text-[#94a3b8] font-light leading-relaxed">
            Whether you are evaluating remittances from <strong>USD to INR ($ to ₹)</strong>, corporate invoice valuations from <strong>EUR to USD</strong>, or high-liquidity trades in <strong>GBP to JPY</strong>, CurrencieConv ensures immediate access to verified market data. We support every sovereign reserve fiat currency alongside regional economies across Asia, the Americas, Europe, and Africa.
          </p>
          <div class="pt-4 flex flex-wrap gap-3">
            <a href="/rates/" class="btn-stripe-primary text-xs !py-2 !px-4">View Complete Rates Table →</a>
            <a href="/widget/" class="btn-stripe-secondary text-xs !py-2 !px-4">Embed Converter Widget</a>
          </div>
        </div>

      </article>
    </div>
  </section>
</Layout>
