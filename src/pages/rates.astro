---
import Layout from '../layouts/Layout.astro';

const popularPairs = [
  { from: 'USD', to: 'EUR', rate: 0.92, change: '+0.5%' },
  { from: 'EUR', to: 'GBP', rate: 0.85, change: '-0.2%' },
  { from: 'GBP', to: 'JPY', rate: 191.2, change: '+1.2%' },
  { from: 'USD', to: 'INR', rate: 83.12, change: '+0.8%' },
  { from: 'EUR', to: 'CHF', rate: 0.96, change: '-0.1%' },
  { from: 'AUD', to: 'CAD', rate: 0.895, change: '+0.3%' },
];

const allCurrencies = [
  { code: 'USD', name: 'United States Dollar', symbol: '$' },
  { code: 'EUR', name: 'Euro', symbol: '€' },
  { code: 'GBP', name: 'British Pound', symbol: '£' },
  { code: 'JPY', name: 'Japanese Yen', symbol: '¥' },
  { code: 'INR', name: 'Indian Rupee', symbol: '₹' },
  { code: 'CAD', name: 'Canadian Dollar', symbol: '$' },
  { code: 'AUD', name: 'Australian Dollar', symbol: 'A$' },
  { code: 'CHF', name: 'Swiss Franc', symbol: 'CHF' },
  { code: 'CNY', name: 'Chinese Yuan', symbol: '¥' },
  { code: 'MXN', name: 'Mexican Peso', symbol: '$' },
];
---

<Layout
  title="Live Currency Exchange Rates Today - Real-Time Forex Rates | CurrencieConv"
  description="Check live currency exchange rates for USD, EUR, GBP, INR, JPY and 150+ world currencies. Real-time forex converter rates updated every minute. Free currency rate today lookup — $ to INR rate, USD to EUR, dollar to rupee and more by Anuska Rani."
  keywords="currency exchange rate, currency exchange rate today, currency rate today, live currency converter, real time currency converter, forex converter, currency conversion rates, usd to eur, usd to inr, $ to inr, $ to inr rate, usd to gbp, euro to dollar, dollar to rupee, accurate currency converter, currency converter live rates"
  currentPath="/rates"
>
  <div class="stripe-mesh-hero pt-10 pb-16 sm:pt-16 sm:pb-20">
    <div class="container-app relative z-10">
      <!-- Header -->
      <div class="max-w-3xl mb-12">
        <span class="pill-tag-soft mb-3">Live Interbank Data</span>
        <h1 class="text-4xl sm:text-5xl font-[300] tracking-[-1.4px] text-[#0d253d] dark:text-white leading-tight mb-4">
          Live Currency Exchange Rates
        </h1>
        <p class="text-base sm:text-lg text-[#273951] dark:text-[#94a3b8] font-[300] leading-relaxed">
          Track real-time market exchange rates for all major world currencies. Synchronized every 60 seconds with institutional interbank pricing.
        </p>
      </div>

      <!-- Popular Pairs Cards -->
      <div class="mb-16">
        <h2 class="text-xl sm:text-2xl font-[300] tracking-tight text-[#0d253d] dark:text-white mb-6">
          Benchmark Currency Corridors
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {popularPairs.map((pair) => (
            <div class="stripe-card p-6 bg-white dark:bg-[#0e1117]">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <p class="text-base font-medium text-[#0d253d] dark:text-white">{pair.from} → {pair.to}</p>
                  <p class="text-xs text-[#64748d] dark:text-[#94a3b8] font-mono">Mid-market spot</p>
                </div>
                <span class="text-xs font-mono font-medium px-2 py-0.5 rounded-full bg-[#e8f7ee] text-[#10b981] dark:bg-[#10b981]/20">
                  {pair.change}
                </span>
              </div>
              <p class="text-3xl font-[300] text-[#533afd] dark:text-[#665efd] font-tabular tracking-tight">
                {pair.rate.toFixed(4)}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- All Currencies Index -->
      <div>
        <h2 class="text-xl sm:text-2xl font-[300] tracking-tight text-[#0d253d] dark:text-white mb-6">
          Global Sovereign Currency Directories
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {allCurrencies.map((currency) => (
            <a href={`/currencies/${currency.code}/`} class="stripe-card p-4 bg-white dark:bg-[#0e1117] group flex items-center justify-between text-decoration-none">
              <div>
                <p class="text-sm font-semibold text-[#0d253d] dark:text-white group-hover:text-[#533afd] dark:group-hover:text-[#665efd] transition-colors">
                  {currency.symbol} {currency.code}
                </p>
                <p class="text-xs text-[#64748d] dark:text-[#94a3b8] font-light">{currency.name}</p>
              </div>
              <svg class="w-4 h-4 text-[#64748d] group-hover:text-[#533afd] group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>
