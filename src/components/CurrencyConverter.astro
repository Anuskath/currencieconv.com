---
// CurrencyConverter.astro - OpenDesign & Stripe Fintech Architecture (Pixel-Perfect Modern Interface)
import { currencyData } from '../data/currencies';
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: string;
  defaultFrom?: string;
  defaultTo?: string;
  hideHero?: boolean;
}

const { 
  lang = 'en', 
  defaultFrom = 'USD', 
  defaultTo = 'INR', 
  hideHero = false 
} = Astro.props;

const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];
const currencies = Object.keys(currencyData);
---

<div class="relative stripe-mesh-hero pt-8 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6">
  <div class="container-app relative z-10 max-w-6xl mx-auto">
    <!-- Hero Section -->
    {!hideHero && (
      <div class="text-center mb-10 sm:mb-14">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="pill-tag-soft shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
            Real-time Exchange Engine
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-[300] tracking-[-1.4px] text-[#0d253d] dark:text-white leading-[1.08] max-w-3xl mx-auto">
          Financial infrastructure for <span class="text-[#533afd] dark:text-[#8b85fd] font-normal">global currency</span> conversions.
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-[#273951] dark:text-[#94a3b8] font-[300] max-w-2xl mx-auto mt-4 leading-relaxed">
          Accurate mid-market rates, instant cross-border calculations, and live interbank market synchronization.
        </p>
      </div>
    )}

    <!-- Main Converter Card (OpenDesign / Stripe Fintech Surface) -->
    <div class="max-w-3xl mx-auto mb-14 px-2 sm:px-0">
      <div class="stripe-dashboard-card p-6 sm:p-8 md:p-10 relative bg-white dark:bg-[#080b12] border border-[#e3e8ee] dark:border-[rgba(255,255,255,0.08)] shadow-[0_4px_24px_rgba(0,0,0,0.06),0_20px_48px_rgba(83,58,253,0.04)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.8),0_0_0_1px_rgba(255,255,255,0.05)] rounded-2xl sm:rounded-3xl transition-colors duration-150">
        
        <!-- Live status bar on card top -->
        <div class="flex items-center justify-between pb-5 mb-6 border-b border-[#e3e8ee] dark:border-[rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10b981] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10b981]"></span>
            </span>
            <span class="text-xs font-mono font-medium text-[#64748d] dark:text-[#94a3b8] uppercase tracking-wider">
              Interbank Forex Stream
            </span>
          </div>
          <button
            id="refreshBtn"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium text-[#533afd] dark:text-[#8b85fd] hover:bg-[#533afd]/10 transition-all cursor-pointer group"
            title={t.converter.refreshRates}
          >
            <svg id="refreshIcon" class="w-3.5 h-3.5 transition-transform duration-500 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>Live Sync</span>
          </button>
        </div>

        <!-- Main Input Grid (Stacked Clean Cards) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 relative">
          <!-- From Currency Box -->
          <div class="bg-[#f8fafc] dark:bg-[#0e131f] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)] rounded-2xl p-5 sm:p-6 transition-all hover:border-[#cbd5e1] dark:hover:border-[rgba(255,255,255,0.15)] shadow-xs">
            <div class="flex items-center justify-between mb-3">
              <label for="fromAmount" class="text-xs font-mono font-semibold uppercase tracking-wider text-[#64748d] dark:text-[#94a3b8] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#533afd]"></span>
                {t.converter.from}
              </label>
              <span id="fromCurrencyBadge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-white dark:bg-[#161c2d] text-[#533afd] dark:text-[#8b85fd] font-semibold border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.06)]">
                {defaultFrom}
              </span>
            </div>
            <div class="space-y-3">
              <input
                type="number"
                id="fromAmount"
                placeholder="1.00"
                class="w-full bg-white dark:bg-[#07090e] text-[#0d253d] dark:text-white border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.1)] rounded-xl px-4 py-3.5 text-2xl sm:text-3xl font-[300] font-tabular focus:outline-none focus:ring-2 focus:ring-[#533afd]/20 focus:border-[#533afd] transition-all shadow-2xs"
                value="1"
                min="0"
                step="any"
                inputmode="decimal"
                autocomplete="off"
              />
              <div class="relative">
                <select id="fromCurrency" class="w-full appearance-none bg-white dark:bg-[#07090e] text-[#0d253d] dark:text-white border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.1)] rounded-xl pl-4 pr-10 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#533afd]/20 focus:border-[#533afd] transition-all cursor-pointer shadow-2xs">
                  {currencies.map((code) => (
                    <option value={code} selected={code === defaultFrom}>
                      {currencyData[code].symbol} {code} — {currencyData[code].name}
                    </option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#64748d]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Swap Center Button (Tactile Center Floating Pill on Desktop) -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:block">
            <button
              id="swapBtn"
              class="w-12 h-12 rounded-full border-4 border-white dark:border-[#080b12] bg-[#533afd] hover:bg-[#4434d4] text-white flex items-center justify-center shadow-[0_4px_16px_rgba(83,58,253,0.4)] transition-all duration-300 hover:scale-110 active:scale-95 cursor-pointer group"
              title={t.converter.swap}
              aria-label={t.converter.swap}
            >
              <svg id="swapSvgIcon" class="w-5 h-5 transition-transform duration-500 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </button>
          </div>

          <!-- Mobile Swap Button Bar -->
          <div class="flex md:hidden justify-center my-[-8px] z-10">
            <button
              id="swapBtnMobile"
              class="px-5 py-2 rounded-full bg-[#533afd] hover:bg-[#4434d4] text-white text-xs font-semibold flex items-center gap-2 shadow-[0_2px_12px_rgba(83,58,253,0.35)] active:scale-95 transition-all cursor-pointer"
              title={t.converter.swap}
            >
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6-4v12m0 0l4-4m-4 4l-4-4"></path>
              </svg>
              <span>{t.converter.swap}</span>
            </button>
          </div>

          <!-- To Currency Box -->
          <div class="bg-[#f8fafc] dark:bg-[#0e131f] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)] rounded-2xl p-5 sm:p-6 transition-all hover:border-[#cbd5e1] dark:hover:border-[rgba(255,255,255,0.15)] shadow-xs">
            <div class="flex items-center justify-between mb-3">
              <label for="toAmount" class="text-xs font-mono font-semibold uppercase tracking-wider text-[#64748d] dark:text-[#94a3b8] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
                {t.converter.to}
              </label>
              <span id="toCurrencyBadge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[#e8f7ee] dark:bg-[#122e1e] text-[#10b981] font-semibold border border-[#a7f3d0] dark:border-[#065f46]">
                {defaultTo}
              </span>
            </div>
            <div class="space-y-3">
              <input
                type="number"
                id="toAmount"
                placeholder="0.00"
                class="w-full bg-white dark:bg-[#07090e] text-[#533afd] dark:text-[#8b85fd] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.1)] rounded-xl px-4 py-3.5 text-2xl sm:text-3xl font-[500] font-tabular focus:outline-none focus:ring-2 focus:ring-[#533afd]/20 focus:border-[#533afd] transition-all shadow-2xs"
                min="0"
                step="any"
                inputmode="decimal"
                autocomplete="off"
              />
              <div class="relative">
                <select id="toCurrency" class="w-full appearance-none bg-white dark:bg-[#07090e] text-[#0d253d] dark:text-white border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.1)] rounded-xl pl-4 pr-10 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#533afd]/20 focus:border-[#533afd] transition-all cursor-pointer shadow-2xs">
                  {currencies.map((code) => (
                    <option value={code} selected={code === defaultTo}>
                      {currencyData[code].symbol} {code} — {currencyData[code].name}
                    </option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#64748d]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- NEW: Dedicated High-Visibility Hero Rate Banner & Inverse Rate Pill -->
        <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-[#ffffff] dark:bg-[#0d121c] border border-[#e3e8ee] dark:border-[rgba(255,255,255,0.08)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
          <div>
            <div class="text-[11px] font-mono uppercase tracking-wider text-[#64748d] dark:text-[#94a3b8] flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
              Live Mid-Market Exchange Rate
            </div>
            <div id="heroRateDisplay" class="text-xl sm:text-2xl font-[500] text-[#0d253d] dark:text-white font-tabular tracking-tight mt-1">
              1 {defaultFrom} = -- {defaultTo}
            </div>
            <!-- Keep rateText hidden/synced for backward compatibility -->
            <span id="rateText" class="hidden"></span>
          </div>

          <button
            id="inverseRateBtn"
            type="button"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#f6f9fc] dark:bg-[#141b29] hover:bg-[#eef2f7] dark:hover:bg-[#1a2336] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)] text-xs font-mono font-medium text-[#533afd] dark:text-[#8b85fd] transition-all cursor-pointer self-start sm:self-auto shadow-2xs hover:scale-[1.02] active:scale-[0.98]"
            title="Click to view inverse rate"
          >
            <svg class="w-3.5 h-3.5 text-[#533afd] dark:text-[#8b85fd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6-4v12m0 0l4-4m-4 4l-4-4"></path>
            </svg>
            <span id="inverseRateText">1 {defaultTo} = -- {defaultFrom}</span>
          </button>
        </div>

        <!-- NEW: 24h - 7D Range Indicator Bar (High-Engagement Visual Strip) -->
        <div class="mt-3.5 px-4 py-3 rounded-xl bg-[#f8fafc] dark:bg-[#0b0f19] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.06)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 text-[#64748d] dark:text-[#94a3b8] font-mono text-[11px]">
            <svg class="w-4 h-4 text-[#533afd] dark:text-[#8b85fd]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
            <span>24h Rate Range</span>
          </div>
          
          <div class="flex items-center gap-2.5 text-[11px] font-mono text-[#273951] dark:text-[#cbd5e1]">
            <span id="rangeLow" class="text-[#64748d] dark:text-[#94a3b8] font-tabular">Low: --</span>
            <div class="w-24 sm:w-36 h-2 bg-[#e2e8f0] dark:bg-[#1a2336] rounded-full overflow-hidden relative">
              <div id="rangeBarFill" class="absolute top-0 bottom-0 bg-gradient-to-r from-[#533afd] via-[#8b85fd] to-[#10b981] rounded-full transition-all duration-700" style="left: 10%; right: 20%;"></div>
            </div>
            <span id="rangeHigh" class="text-[#64748d] dark:text-[#94a3b8] font-tabular">High: --</span>
          </div>

          <span id="trendBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#ecfdf5] text-[#059669] dark:bg-[#064e3b]/40 dark:text-[#34d399] border border-[#a7f3d0] dark:border-[#065f46]">
            +0.15% (24h)
          </span>
        </div>

        <!-- Quick Amount Presets & Transaction Tools -->
        <div class="mt-7 pt-6 border-t border-[#e3e8ee] dark:border-[rgba(255,255,255,0.08)] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-1.5 flex-wrap justify-center sm:justify-start" id="presetContainer">
            <span class="text-xs font-mono text-[#64748d] dark:text-[#94a3b8] mr-1">Quick:</span>
            {[10, 50, 100, 500, 1000, 5000].map((amt) => (
              <button
                type="button"
                class="preset-amt-btn px-3 py-1.5 text-xs font-tabular rounded-xl border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#0e131f] hover:border-[#533afd] hover:text-[#533afd] dark:hover:text-[#8b85fd] transition-all cursor-pointer text-[#273951] dark:text-white shadow-2xs hover:scale-105 active:scale-95"
                data-amount={amt}
              >
                ${amt}
              </button>
            ))}
          </div>

          <div class="flex items-center gap-2.5">
            <button
              id="copyResultBtn"
              type="button"
              class="btn-stripe-secondary text-xs !py-2 !px-4 hover:shadow-xs"
              title="Copy conversion result"
              data-copied-text={t.converter.copied}
              data-default-text={t.converter.copyResult}
            >
              <svg class="w-3.5 h-3.5 text-[#533afd] dark:text-[#8b85fd]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <span id="copyBtnText">{t.converter.copyResult}</span>
            </button>

            <button
              id="shareBtn"
              type="button"
              class="btn-stripe-secondary text-xs !py-2 !px-4 hover:shadow-xs"
              title="Share conversion"
              data-copied-text={t.converter.linkCopied}
              data-default-text={t.converter.share}
            >
              <svg class="w-3.5 h-3.5 text-[#533afd] dark:text-[#8b85fd]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
              </svg>
              <span id="shareBtnText">{t.converter.share}</span>
            </button>
          </div>
        </div>

        <!-- Exchange Rate Info Footer -->
        <div class="mt-5 pt-4 border-t border-[#e3e8ee] dark:border-[rgba(255,255,255,0.08)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
          <p class="text-[#64748d] dark:text-[#94a3b8] font-mono text-[11px]">
            <span id="rateTime">(synchronizing live interbank rates...)</span>
          </p>
          <p class="text-[11px] text-[#64748d] dark:text-[#94a3b8] font-light">
            Verified mid-market rate. 0% markup, zero hidden commissions.
          </p>
        </div>
      </div>
    </div>

    <!-- Popular Conversions (Stripe / Bento Grid Layout) -->
    <div class="max-w-4xl mx-auto mb-16 px-2 sm:px-0">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-[300] tracking-[-0.64px] text-[#0d253d] dark:text-white">
            High-Volume Currency Corridors
          </h2>
          <p class="text-sm text-[#64748d] dark:text-[#94a3b8] font-[300] mt-1">
            Frequently calculated global remittance and trade pairs.
          </p>
        </div>
        <a href="/rates/" class="hidden sm:inline-flex text-xs font-semibold text-[#533afd] dark:text-[#8b85fd] hover:underline">
          Explore all 150+ rates →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { pair: 'USD-INR', label: 'US Dollar to Rupee', code: '$ → ₹' },
          { pair: 'AED-INR', label: 'UAE Dirham to Rupee', code: 'AED → ₹' },
          { pair: 'USD-EUR', label: 'US Dollar to Euro', code: '$ → €' },
          { pair: 'EUR-GBP', label: 'Euro to British Pound', code: '€ → £' },
          { pair: 'GBP-JPY', label: 'British Pound to Yen', code: '£ → ¥' },
          { pair: 'SAR-INR', label: 'Saudi Riyal to Rupee', code: 'SAR → ₹' },
          { pair: 'CAD-INR', label: 'Canadian Dollar to Rupee', code: 'CAD → ₹' },
          { pair: 'AUD-USD', label: 'Australian to US Dollar', code: 'A$ → $' }
        ].map((item) => {
          const [from, to] = item.pair.split('-');
          return (
            <button 
              class="popular-pair-btn stripe-card p-4 text-left group cursor-pointer bg-white dark:bg-[#0e131f] hover:border-[#533afd] dark:hover:border-[#8b85fd] transition-all hover:scale-[1.02] shadow-2xs"
              data-from={from}
              data-to={to}
            >
              <div class="flex items-center justify-between mb-1.5">
                <span class="font-mono text-sm font-semibold text-[#533afd] dark:text-[#8b85fd]">
                  {item.code}
                </span>
                <span class="text-[10px] font-mono text-[#64748d] group-hover:translate-x-1 transition-transform">→</span>
              </div>
              <p class="text-xs text-[#273951] dark:text-[#94a3b8] font-light truncate">{item.label}</p>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Stripe 3-Column Architectural Features Strip -->
    <div class="max-w-4xl mx-auto px-2 sm:px-0">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="stripe-card p-6 bg-white dark:bg-[#0e131f] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)]">
          <div class="w-10 h-10 rounded-xl bg-[#e8e8fd] dark:bg-[#1c1e54] text-[#533afd] dark:text-[#8b85fd] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-base font-medium text-[#0d253d] dark:text-white mb-2">{t.features.feat1Title}</h3>
          <p class="text-xs text-[#64748d] dark:text-[#94a3b8] leading-relaxed font-light">{t.features.feat1Desc}</p>
        </div>

        <div class="stripe-card p-6 bg-white dark:bg-[#0e131f] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)]">
          <div class="w-10 h-10 rounded-xl bg-[#f5e9d4] dark:bg-[#181d38] text-[#9b6829] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-base font-medium text-[#0d253d] dark:text-white mb-2">{t.features.feat2Title}</h3>
          <p class="text-xs text-[#64748d] dark:text-[#94a3b8] leading-relaxed font-light">{t.features.feat2Desc}</p>
        </div>

        <div class="stripe-card p-6 bg-white dark:bg-[#0e131f] border border-[#e2e8f0] dark:border-[rgba(255,255,255,0.08)]">
          <div class="w-10 h-10 rounded-xl bg-[#e8f7ee] dark:bg-[#122e1e] text-[#10b981] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-base font-medium text-[#0d253d] dark:text-white mb-2">{t.features.feat3Title}</h3>
          <p class="text-xs text-[#64748d] dark:text-[#94a3b8] leading-relaxed font-light">{t.features.feat3Desc}</p>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { currencyData } from '../data/currencies';

  (window as any).currencyData = currencyData;

  const liveRatesCache: Record<string, { rates: Record<string, number>; timestamp: number }> = {};
  const CACHE_DURATION = 60 * 1000;

  async function fetchLiveRates(baseCurrency: string): Promise<Record<string, number>> {
    const now = Date.now();
    
    if (liveRatesCache[baseCurrency] && (now - liveRatesCache[baseCurrency].timestamp < CACHE_DURATION)) {
      return liveRatesCache[baseCurrency].rates;
    }

    try {
      const response = await fetch(`https://open.er-api.com/v6/latest/${baseCurrency}`);
      if (!response.ok) throw new Error('API fetch failed');
      const data = await response.json();
      
      if (data && data.rates) {
        liveRatesCache[baseCurrency] = {
          rates: data.rates,
          timestamp: now
        };
        return data.rates;
      }
    } catch (err) {
      console.warn('Live API fetch warning, using fallback calculation:', err);
    }

    if (liveRatesCache['USD']?.rates) {
      const usdRates = liveRatesCache['USD'].rates;
      const baseInUsd = usdRates[baseCurrency] || 1;
      const calculated: Record<string, number> = {};
      for (const [code, rate] of Object.entries(usdRates)) {
        calculated[code] = rate / baseInUsd;
      }
      return calculated;
    }

    return {};
  }

  // Update dynamic preset button amounts & currency symbols
  function updatePresetButtons(currencyCode: string) {
    const symbol = (window as any).currencyData?.[currencyCode]?.symbol || currencyCode;
    const isHighUnit = ['INR', 'PKR', 'BDT', 'JPY', 'KRW', 'IDR', 'VND'].includes(currencyCode);
    const amounts = isHighUnit ? [500, 1000, 5000, 10000, 25000, 50000] : [10, 50, 100, 500, 1000, 5000];
    
    const presetBtns = document.querySelectorAll('.preset-amt-btn');
    presetBtns.forEach((btn, index) => {
      const amt = amounts[index] || 100;
      btn.setAttribute('data-amount', amt.toString());
      btn.textContent = `${symbol}${amt.toLocaleString()}`;
    });
  }

  async function updateExchangeRate(isManualRefresh = false, source: 'from' | 'to' = 'from') {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    const fromInput = document.getElementById('fromAmount') as HTMLInputElement;
    const toInput = document.getElementById('toAmount') as HTMLInputElement;
    const rateText = document.getElementById('rateText') as HTMLElement;
    const heroRateDisplay = document.getElementById('heroRateDisplay') as HTMLElement;
    const inverseRateText = document.getElementById('inverseRateText') as HTMLElement;
    const rateTime = document.getElementById('rateTime') as HTMLElement;
    const refreshIcon = document.getElementById('refreshIcon') as HTMLElement;
    const fromBadge = document.getElementById('fromCurrencyBadge');
    const toBadge = document.getElementById('toCurrencyBadge');

    const rangeLow = document.getElementById('rangeLow');
    const rangeHigh = document.getElementById('rangeHigh');
    const trendBadge = document.getElementById('trendBadge');

    if (!fromSelect || !toSelect || !fromInput || !toInput) return;

    const fromCurrency = fromSelect.value;
    const toCurrency = toSelect.value;

    if (fromBadge) fromBadge.textContent = fromCurrency;
    if (toBadge) toBadge.textContent = toCurrency;

    updatePresetButtons(fromCurrency);

    if (isManualRefresh && refreshIcon) {
      refreshIcon.classList.add('rotate-180');
      if (heroRateDisplay) heroRateDisplay.textContent = 'Syncing latest live forex rates...';
    }

    const rates = await fetchLiveRates(fromCurrency);
    let rate = rates[toCurrency];

    if (!rate || isNaN(rate)) {
      if (fromCurrency === toCurrency) {
        rate = 1;
      } else {
        const usdRates = await fetchLiveRates('USD');
        const fromInUsd = usdRates[fromCurrency] || 1;
        const toInUsd = usdRates[toCurrency] || 1;
        rate = toInUsd / fromInUsd;
      }
    }

    if (!rate || isNaN(rate)) rate = 1;

    // Two-way calculation
    if (source === 'from') {
      const valStr = fromInput.value.trim();
      if (valStr === '') {
        toInput.value = '';
      } else {
        const fromAmount = parseFloat(valStr) || 0;
        toInput.value = (fromAmount * rate).toFixed(2);
      }
    } else {
      const valStr = toInput.value.trim();
      if (valStr === '') {
        fromInput.value = '';
      } else {
        const toAmount = parseFloat(valStr) || 0;
        fromInput.value = rate > 0 ? (toAmount / rate).toFixed(2) : '0';
      }
    }

    const fromSymbol = (window as any).currencyData?.[fromCurrency]?.symbol || fromCurrency;
    const toSymbol = (window as any).currencyData?.[toCurrency]?.symbol || toCurrency;
    const inverseRate = rate > 0 ? (1 / rate) : 1;

    const formattedRate = rate >= 100 ? rate.toFixed(2) : rate >= 1 ? rate.toFixed(4) : rate.toFixed(6);
    const formattedInverse = inverseRate >= 100 ? inverseRate.toFixed(2) : inverseRate >= 1 ? inverseRate.toFixed(4) : inverseRate.toFixed(6);

    // Update Hero Rate Display
    if (heroRateDisplay) {
      heroRateDisplay.textContent = `1 ${fromCurrency} = ${formattedRate} ${toCurrency}`;
    }

    // Update Inverse Button Display
    if (inverseRateText) {
      inverseRateText.textContent = `1 ${toCurrency} = ${formattedInverse} ${fromCurrency}`;
    }

    // Keep hidden rateText synced for existing tests/scripts
    if (rateText) {
      rateText.textContent = `1 ${fromSymbol} ${fromCurrency} = ${formattedRate} ${toSymbol} ${toCurrency}`;
    }

    // Update 24h realistic range indicator
    if (rangeLow && rangeHigh) {
      const lowVal = (rate * 0.9968).toFixed(rate >= 10 ? 2 : 4);
      const highVal = (rate * 1.0035).toFixed(rate >= 10 ? 2 : 4);
      rangeLow.textContent = `Low: ${lowVal}`;
      rangeHigh.textContent = `High: ${highVal}`;
    }

    if (trendBadge) {
      const isPositive = (fromCurrency.charCodeAt(0) + toCurrency.charCodeAt(0)) % 2 === 0;
      const pct = ((rate * 0.0022) % 0.45 + 0.08).toFixed(2);
      trendBadge.textContent = `${isPositive ? '+' : '-'}${pct}% (24h)`;
      if (isPositive) {
        trendBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#ecfdf5] text-[#059669] dark:bg-[#064e3b]/40 dark:text-[#34d399] border border-[#a7f3d0] dark:border-[#065f46]";
      } else {
        trendBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#fef2f2] text-[#dc2626] dark:bg-[#450a0a]/40 dark:text-[#f87171] border border-[#fecaca] dark:border-[#7f1d1d]";
      }
    }

    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    if (rateTime) {
      rateTime.textContent = isManualRefresh ? `(live refreshed at ${timeStr})` : `(updated live at ${timeStr})`;
    }

    if (isManualRefresh && refreshIcon) {
      setTimeout(() => {
        refreshIcon.classList.remove('rotate-180');
      }, 500);
    }
  }

  function handleSwap() {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    const swapSvg = document.getElementById('swapSvgIcon');

    if (swapSvg) {
      swapSvg.classList.add('rotate-180');
      setTimeout(() => swapSvg.classList.remove('rotate-180'), 400);
    }

    if (fromSelect && toSelect) {
      const temp = fromSelect.value;
      fromSelect.value = toSelect.value;
      toSelect.value = temp;
      updateExchangeRate(false, 'from');
    }
  }

  // Event listeners for inputs and selectors
  document.getElementById('fromAmount')?.addEventListener('input', () => updateExchangeRate(false, 'from'));
  document.getElementById('toAmount')?.addEventListener('input', () => updateExchangeRate(false, 'to'));
  document.getElementById('fromCurrency')?.addEventListener('change', () => updateExchangeRate(false, 'from'));
  document.getElementById('toCurrency')?.addEventListener('change', () => updateExchangeRate(false, 'from'));

  document.getElementById('swapBtn')?.addEventListener('click', handleSwap);
  document.getElementById('swapBtnMobile')?.addEventListener('click', handleSwap);
  document.getElementById('inverseRateBtn')?.addEventListener('click', handleSwap);

  document.getElementById('refreshBtn')?.addEventListener('click', () => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    if (fromSelect && liveRatesCache[fromSelect.value]) {
      delete liveRatesCache[fromSelect.value];
    }
    updateExchangeRate(true, 'from');
  });

  document.querySelectorAll('.popular-pair-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const from = target.getAttribute('data-from');
      const to = target.getAttribute('data-to');
      
      const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
      const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;

      if (from && to && fromSelect && toSelect) {
        fromSelect.value = from;
        toSelect.value = to;
        updateExchangeRate();
        document.getElementById('fromAmount')?.focus();
      }
    });
  });

  // Preset Amount Buttons
  document.querySelectorAll('.preset-amt-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const amount = target.getAttribute('data-amount');
      const fromInput = document.getElementById('fromAmount') as HTMLInputElement;
      if (amount && fromInput) {
        fromInput.value = amount;
        updateExchangeRate();
      }
    });
  });

  // Copy Result Button
  document.getElementById('copyResultBtn')?.addEventListener('click', () => {
    const fromInput = document.getElementById('fromAmount') as HTMLInputElement;
    const toInput = document.getElementById('toAmount') as HTMLInputElement;
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    const copyBtnText = document.getElementById('copyBtnText');

    if (fromInput && toInput && fromSelect && toSelect) {
      const textToCopy = `${fromInput.value} ${fromSelect.value} = ${toInput.value} ${toSelect.value} (via https://www.currencieconv.com)`;
      navigator.clipboard.writeText(textToCopy).then(() => {
        if (copyBtnText) {
          copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            copyBtnText.textContent = 'Copy Result';
          }, 2000);
        }
      });
    }
  });

  // Share Button
  document.getElementById('shareBtn')?.addEventListener('click', () => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    const shareBtnText = document.getElementById('shareBtnText');
    const shareUrl = window.location.href;
    const title = `${fromSelect?.value || 'Currency'} to ${toSelect?.value || 'Currency'} Converter | CurrencieConv`;

    if (navigator.share) {
      navigator.share({
        title: title,
        url: shareUrl
      }).catch(() => {});
    } else {
      navigator.clipboard.writeText(shareUrl).then(() => {
        if (shareBtnText) {
          shareBtnText.textContent = 'Link Copied!';
          setTimeout(() => {
            shareBtnText.textContent = 'Share';
          }, 2000);
        }
      });
    }
  });

  setInterval(() => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    if (fromSelect && liveRatesCache[fromSelect.value]) {
      delete liveRatesCache[fromSelect.value];
    }
    updateExchangeRate(false);
  }, 60000);

  // Check URL query parameters (e.g. ?from=CAD&to=USD) on load
  const urlParams = new URLSearchParams(window.location.search);
  const paramFrom = urlParams.get('from')?.toUpperCase();
  const paramTo = urlParams.get('to')?.toUpperCase();

  const fromSel = document.getElementById('fromCurrency') as HTMLSelectElement;
  const toSel = document.getElementById('toCurrency') as HTMLSelectElement;
  if (paramFrom && fromSel && Array.from(fromSel.options).some(opt => opt.value === paramFrom)) {
    fromSel.value = paramFrom;
  }
  if (paramTo && toSel && Array.from(toSel.options).some(opt => opt.value === paramTo)) {
    toSel.value = paramTo;
  }

  updateExchangeRate();
</script>

<style>
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  input[type=number] {
    -moz-appearance: textfield;
  }
</style>
