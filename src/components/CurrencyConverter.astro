---
// CurrencyConverter.astro - Main converter component with Live Interbank Rate API & Auto-Refresh
import { currencyData } from '../data/currencies';

const currencies = Object.keys(currencyData);
---

<div class="py-8 sm:py-12 md:py-16 px-4 sm:px-6">
  <div class="container-app max-w-6xl mx-auto">
    <!-- Hero Section -->
    <div class="text-center mb-8 sm:mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-link-bg-soft dark:bg-blue-900/30 text-link text-xs font-semibold font-mono mb-4 border border-blue-200 dark:border-blue-800">
        <span class="w-2 h-2 rounded-full bg-link animate-pulse"></span>
        Live Mid-Market Rates Connected
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 sm:mb-4 text-primary">
        Currency Converter
      </h1>
      <p class="text-sm sm:text-base md:text-lg text-body max-w-2xl mx-auto px-2">
        Real-time market exchange rates for 150+ world currencies. Fast, reliable, and completely free.
      </p>
    </div>

    <!-- Converter Box -->
    <div class="max-w-2xl mx-auto mb-12 px-4 sm:px-0">
      <div class="bg-canvas-soft border border-hairline rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-8 shadow-[0_0_0_1px_rgba(255,255,255,0.02)] dark:bg-slate-900">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 md:gap-6">
          <!-- From Currency -->
          <div class="flex flex-col">
            <label for="fromAmount" class="text-body-sm-strong text-primary mb-2">From</label>
            <div class="flex flex-col sm:flex-row gap-2">
              <input
                type="number"
                id="fromAmount"
                placeholder="1.00"
                class="input-field flex-1 text-sm sm:text-base"
                value="1"
                min="0"
                step="any"
              />
              <select id="fromCurrency" class="input-field w-full sm:w-44 text-sm sm:text-base font-medium">
                {currencies.map((code) => (
                  <option value={code} selected={code === 'USD'}>
                    {currencyData[code].symbol} {code} - {currencyData[code].name}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <!-- Swap Button -->
          <div class="flex items-end justify-center md:justify-center pb-0">
            <button
              id="swapBtn"
              class="w-full sm:w-auto px-3 sm:px-4 py-3 border border-hairline rounded-lg hover:bg-canvas-soft dark:hover:bg-slate-800 transition-all text-primary flex items-center justify-center gap-2 group"
              title="Swap currencies"
              aria-label="Swap currencies"
            >
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6-4v12m0 0l4-4m-4 4l-4-4"></path>
              </svg>
              <span class="md:hidden text-sm font-medium">Swap Currencies</span>
            </button>
          </div>

          <!-- To Currency -->
          <div class="flex flex-col">
            <label for="toAmount" class="text-body-sm-strong text-primary mb-2">To</label>
            <div class="flex flex-col sm:flex-row gap-2">
              <input
                type="number"
                id="toAmount"
                placeholder="0.00"
                class="input-field flex-1 text-sm sm:text-base font-semibold text-link dark:text-cyan-400"
                readonly
              />
              <select id="toCurrency" class="input-field w-full sm:w-44 text-sm sm:text-base font-medium">
                {currencies.map((code) => (
                  <option value={code} selected={code === 'INR'}>
                    {currencyData[code].symbol} {code} - {currencyData[code].name}
                  </option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- Exchange Rate Info & Disclaimer -->
        <div class="mt-4 sm:mt-6 pt-4 sm:pt-6 border-t border-hairline">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
            <p class="text-body-sm text-mute text-center sm:text-left">
              <span id="rateText" class="block sm:inline font-semibold text-primary">Fetching live mid-market rate...</span>
              <span id="rateTime" class="text-caption text-mute ml-0 sm:ml-2 block sm:inline font-mono"></span>
            </p>
            <button
              id="refreshBtn"
              class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline bg-canvas hover:bg-canvas-soft dark:bg-slate-800 dark:hover:bg-slate-700 text-link hover:text-link-deep dark:hover:text-cyan-400 transition-all text-xs font-semibold whitespace-nowrap group"
              title="Refresh live market rates"
            >
              <svg id="refreshIcon" class="w-3.5 h-3.5 transition-transform duration-500 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              <span>Refresh Rates</span>
            </button>
          </div>
          <p class="text-[11px] text-mute text-center sm:text-left italic">
            * Rates provided are indicative mid-market rates sourced from Open Exchange Rates API for informational purposes.
          </p>
        </div>
      </div>
    </div>

    <!-- Popular Conversions -->
    <div class="max-w-2xl mx-auto mb-12 sm:mb-16 px-4 sm:px-0">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 sm:mb-6 text-primary">Popular Conversions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        {[
          { pair: 'USD-INR', label: 'US Dollar to Indian Rupee ($ to INR)' },
          { pair: 'AED-INR', label: 'UAE Dirham to Indian Rupee' },
          { pair: 'USD-EUR', label: 'US Dollar to Euro' },
          { pair: 'EUR-GBP', label: 'Euro to British Pound' },
          { pair: 'GBP-JPY', label: 'British Pound to Japanese Yen' },
          { pair: 'SAR-INR', label: 'Saudi Riyal to Indian Rupee' },
          { pair: 'CAD-INR', label: 'Canadian Dollar to Indian Rupee' },
          { pair: 'AUD-USD', label: 'Australian Dollar to US Dollar' }
        ].map((item) => {
          const [from, to] = item.pair.split('-');
          const fromSymbol = currencyData[from]?.symbol || from;
          const toSymbol = currencyData[to]?.symbol || to;
          return (
            <button 
              class="popular-pair-btn card text-left hover:shadow-lg transition-all p-4 border border-hairline rounded-xl hover:border-link group cursor-pointer"
              data-from={from}
              data-to={to}
            >
              <p class="text-base sm:text-lg font-semibold text-primary mb-1 group-hover:text-link transition-colors">
                {fromSymbol} {from} → {toSymbol} {to}
              </p>
              <p class="text-xs sm:text-sm text-mute">{item.label}</p>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Features -->
    <div class="max-w-3xl mx-auto px-4 sm:px-0">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 bg-link-bg-soft dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-body-md-strong mb-2">Live Market Data</h3>
          <p class="text-body-sm text-mute">Real-time forex exchange rates fetched live & auto-updated every 60 seconds</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 bg-cyan-soft dark:bg-cyan-900/30 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-cyan-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-body-md-strong mb-2">150+ World Currencies</h3>
          <p class="text-body-sm text-mute">USD, EUR, GBP, INR, AED, CAD, AUD, JPY, SAR and more with high precision</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 bg-success/10 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-body-md-strong mb-2">Always Free</h3>
          <p class="text-body-sm text-mute">No hidden service fees, no account required, completely free to use</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { currencyData } from '../data/currencies';

  (window as any).currencyData = currencyData;

  const liveRatesCache: Record<string, { rates: Record<string, number>; timestamp: number }> = {};
  const CACHE_DURATION = 60 * 1000;

  async function fetchLiveRates(baseCurrency: string): Promise<Record<string, number>> {
    const now = Date.now();
    
    if (liveRatesCache[baseCurrency] && (now - liveRatesCache[baseCurrency].timestamp < CACHE_DURATION)) {
      return liveRatesCache[baseCurrency].rates;
    }

    try {
      const response = await fetch(`https://open.er-api.com/v6/latest/${baseCurrency}`);
      if (!response.ok) throw new Error('API fetch failed');
      const data = await response.json();
      
      if (data && data.rates) {
        liveRatesCache[baseCurrency] = {
          rates: data.rates,
          timestamp: now
        };
        return data.rates;
      }
    } catch (err) {
      console.warn('Live API fetch warning, using fallback calculation:', err);
    }

    if (liveRatesCache['USD']?.rates) {
      const usdRates = liveRatesCache['USD'].rates;
      const baseInUsd = usdRates[baseCurrency] || 1;
      const calculated: Record<string, number> = {};
      for (const [code, rate] of Object.entries(usdRates)) {
        calculated[code] = rate / baseInUsd;
      }
      return calculated;
    }

    return {};
  }

  async function updateExchangeRate(isManualRefresh = false) {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    const fromInput = document.getElementById('fromAmount') as HTMLInputElement;
    const toInput = document.getElementById('toAmount') as HTMLInputElement;
    const rateText = document.getElementById('rateText') as HTMLElement;
    const rateTime = document.getElementById('rateTime') as HTMLElement;
    const refreshIcon = document.getElementById('refreshIcon') as HTMLElement;

    if (!fromSelect || !toSelect || !fromInput || !toInput) return;

    const fromCurrency = fromSelect.value;
    const toCurrency = toSelect.value;
    const fromAmount = parseFloat(fromInput.value) || 0;

    if (isManualRefresh && refreshIcon) {
      refreshIcon.classList.add('rotate-180');
      if (rateText) rateText.textContent = 'Fetching latest live market rates...';
    }

    const rates = await fetchLiveRates(fromCurrency);
    let rate = rates[toCurrency];

    if (!rate || isNaN(rate)) {
      if (fromCurrency === toCurrency) {
        rate = 1;
      } else {
        const usdRates = await fetchLiveRates('USD');
        const fromInUsd = usdRates[fromCurrency] || 1;
        const toInUsd = usdRates[toCurrency] || 1;
        rate = toInUsd / fromInUsd;
      }
    }

    const toAmount = (fromAmount * rate).toFixed(2);
    const fromSymbol = (window as any).currencyData?.[fromCurrency]?.symbol || fromCurrency;
    const toSymbol = (window as any).currencyData?.[toCurrency]?.symbol || toCurrency;

    toInput.value = toAmount;
    if (rateText) {
      rateText.textContent = `1 ${fromSymbol} ${fromCurrency} = ${rate.toFixed(4)} ${toSymbol} ${toCurrency}`;
    }

    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    if (rateTime) {
      rateTime.textContent = isManualRefresh ? `(live refreshed at ${timeStr})` : `(updated live at ${timeStr})`;
    }

    if (isManualRefresh && refreshIcon) {
      setTimeout(() => {
        refreshIcon.classList.remove('rotate-180');
      }, 500);
    }
  }

  // Event listeners
  document.getElementById('fromAmount')?.addEventListener('input', () => updateExchangeRate());
  document.getElementById('fromCurrency')?.addEventListener('change', () => updateExchangeRate());
  document.getElementById('toCurrency')?.addEventListener('change', () => updateExchangeRate());

  document.getElementById('swapBtn')?.addEventListener('click', () => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;
    if (fromSelect && toSelect) {
      const temp = fromSelect.value;
      fromSelect.value = toSelect.value;
      toSelect.value = temp;
      updateExchangeRate();
    }
  });

  document.getElementById('refreshBtn')?.addEventListener('click', () => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    if (fromSelect && liveRatesCache[fromSelect.value]) {
      delete liveRatesCache[fromSelect.value];
    }
    updateExchangeRate(true);
  });

  document.querySelectorAll('.popular-pair-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const from = target.getAttribute('data-from');
      const to = target.getAttribute('data-to');
      
      const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
      const toSelect = document.getElementById('toCurrency') as HTMLSelectElement;

      if (from && to && fromSelect && toSelect) {
        fromSelect.value = from;
        toSelect.value = to;
        updateExchangeRate();
        document.getElementById('fromAmount')?.focus();
      }
    });
  });

  setInterval(() => {
    const fromSelect = document.getElementById('fromCurrency') as HTMLSelectElement;
    if (fromSelect && liveRatesCache[fromSelect.value]) {
      delete liveRatesCache[fromSelect.value];
    }
    updateExchangeRate(false);
  }, 60000);

  updateExchangeRate();
</script>

<style>
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  input[type=number] {
    -moz-appearance: textfield;
  }
</style>
