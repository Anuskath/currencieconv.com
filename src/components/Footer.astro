---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];
const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-canvas-soft dark:bg-slate-900 border-t border-hairline mt-12 sm:mt-16 md:mt-20">
  <div class="container-app py-8 sm:py-12 px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-gradient-develop rounded-lg flex items-center justify-center shadow-sm">
            <span class="text-white font-bold text-sm font-mono">CC</span>
          </div>
          <span class="font-semibold text-primary">CurrencieConv</span>
        </div>
        <p class="text-xs sm:text-sm text-mute leading-relaxed mb-3">
          {t.hero.subtitle}
        </p>
        <p class="text-xs text-mute font-mono">
          Founded by <span class="text-primary font-medium">Anuska Rani</span>
        </p>
      </div>

      <!-- Tools & Rates -->
      <div>
        <h4 class="text-sm sm:text-base font-semibold mb-3 sm:mb-4 text-primary">Converter Tools</h4>
        <ul class="space-y-1.5 sm:space-y-2">
          <li><a href={localePrefix || '/'} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">{t.nav.converter}</a></li>
          <li><a href={`${localePrefix}/rates`} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">{t.nav.rates}</a></li>
          <li><a href={`${localePrefix}/widget`} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors font-medium text-link">{t.nav.widget}</a></li>
          <li><a href="/usd-to-inr" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">USD to INR Rate</a></li>
          <li><a href="/aed-to-inr" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">AED to INR Rate</a></li>
          <li><a href="/eur-to-usd" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">EUR to USD Rate</a></li>
        </ul>
      </div>

      <!-- Company & Info -->
      <div>
        <h4 class="text-sm sm:text-base font-semibold mb-3 sm:mb-4 text-primary">Company & Info</h4>
        <ul class="space-y-1.5 sm:space-y-2">
          <li><a href={`${localePrefix}/about`} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">{t.nav.about}</a></li>
          <li><a href={`${localePrefix}/faq`} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">{t.nav.faq}</a></li>
          <li><a href={`${localePrefix}/contact`} class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">{t.nav.contact}</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-sm sm:text-base font-semibold mb-3 sm:mb-4 text-primary">Legal & Privacy</h4>
        <ul class="space-y-1.5 sm:space-y-2">
          <li><a href="/privacy" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="text-xs sm:text-sm text-mute hover:text-primary transition-colors">Feedback & Inquiries</a></li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-hairline my-6 sm:my-8"></div>

    <!-- Bottom -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-xs sm:text-sm text-mute text-center sm:text-left">
        © {currentYear} CurrencieConv by Anuska Rani. All rights reserved. Free online currency converter tool.
      </p>
      <div class="flex gap-4 sm:gap-6 justify-center sm:justify-end">
        <a href="/privacy" class="text-xs text-mute hover:text-primary transition-colors">Privacy</a>
        <a href="/terms" class="text-xs text-mute hover:text-primary transition-colors">Terms</a>
        <a href="/contact" class="text-xs text-mute hover:text-primary transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
