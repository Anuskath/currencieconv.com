---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];
const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-[#0b0d1b] border-t border-[#e3e8ee] dark:border-[#22284c] mt-16 sm:mt-24">
  <div class="container-app py-16 px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand & Mission -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg bg-[#533afd] text-white flex items-center justify-center font-bold text-xs shadow-xs">
            <span class="font-mono">CC</span>
          </div>
          <span class="font-bold text-base text-[#0d253d] dark:text-white tracking-tight">CurrencieConv</span>
        </div>
        <p class="text-[13px] text-[#64748d] dark:text-[#94a3b8] leading-relaxed mb-4 font-light">
          Real-time global exchange rates and currency converter infrastructure. Transparent, live mid-market pricing.
        </p>
        <p class="text-[11px] text-[#64748d] dark:text-[#94a3b8] font-mono">
          Architected by <span class="text-[#0d253d] dark:text-white font-medium">Anuska Rani</span>
        </p>
      </div>

      <!-- Tools & Rates -->
      <div>
        <h4 class="text-[14px] font-semibold mb-4 text-[#0d253d] dark:text-white tracking-tight uppercase font-mono text-xs">Financial Tools</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href={localePrefix ? `${localePrefix}/` : '/'} class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">{t.nav.converter}</a></li>
          <li><a href="/rates/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">{t.nav.rates}</a></li>
          <li><a href="/widget/" class="text-[#533afd] dark:text-[#665efd] hover:underline font-medium transition-colors">{t.nav.widget}</a></li>
          <li><a href="/usd-to-inr/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors font-tabular">USD to INR ($ to ₹)</a></li>
          <li><a href="/aed-to-inr/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors font-tabular">AED to INR Rate</a></li>
          <li><a href="/eur-to-usd/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors font-tabular">EUR to USD Rate</a></li>
        </ul>
      </div>

      <!-- Company & Knowledge -->
      <div>
        <h4 class="text-[14px] font-semibold mb-4 text-[#0d253d] dark:text-white tracking-tight uppercase font-mono text-xs">Knowledge & Info</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/guides/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors font-medium">{t.nav.guides}</a></li>
          <li><a href="/about/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">{t.nav.about}</a></li>
          <li><a href="/faq/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">{t.nav.faq}</a></li>
          <li><a href="/contact/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">{t.nav.contact}</a></li>
        </ul>
      </div>

      <!-- Legal & Infrastructure -->
      <div>
        <h4 class="text-[14px] font-semibold mb-4 text-[#0d253d] dark:text-white tracking-tight uppercase font-mono text-xs">Security & Legal</h4>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/privacy/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Terms of Service</a></li>
          <li><a href="/contact/" class="text-[#64748d] dark:text-[#94a3b8] hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Compliance & Inquiries</a></li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-[#e3e8ee] dark:border-[#22284c] my-8"></div>

    <!-- Bottom Row -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-[13px] text-[#64748d] dark:text-[#94a3b8]">
      <p class="font-light">
        © {currentYear} CurrencieConv by Anuska Rani. Live interbank exchange rate data engine.
      </p>
      <div class="flex gap-6 justify-start sm:justify-end">
        <a href="/privacy/" class="hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Terms</a>
        <a href="/contact/" class="hover:text-[#533afd] dark:hover:text-[#665efd] transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
