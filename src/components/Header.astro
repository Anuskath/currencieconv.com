---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  currentPath?: string;
  lang?: string;
}

const { currentPath = '/', lang = 'en' } = Astro.props;
const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];

const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;

const navItems = [
  { label: t.nav.converter, href: localePrefix || '/' },
  { label: t.nav.rates, href: `${localePrefix}/rates` },
  { label: t.nav.widget, href: `${localePrefix}/widget` },
  { label: t.nav.about, href: `${localePrefix}/about` },
  { label: t.nav.contact, href: `${localePrefix}/contact` },
  { label: t.nav.faq, href: `${localePrefix}/faq` },
];

const languages = [
  { code: 'en', label: 'English', flag: '🇺🇸', href: '/' },
  { code: 'es', label: 'Español', flag: '🇪🇸', href: '/es' },
  { code: 'pt', label: 'Português', flag: '🇧🇷', href: '/pt' },
  { code: 'fr', label: 'Français', flag: '🇫🇷', href: '/fr' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪', href: '/de' },
];

const activeLang = languages.find(l => l.code === currentLocale) || languages[0];
---

<header class="bg-canvas/90 border-b border-hairline sticky top-0 z-50 backdrop-blur-sm dark:bg-slate-950/90">
  <div class="container-app py-3 sm:py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href={localePrefix || '/'} class="flex items-center gap-2 group">
      <div class="w-8 h-8 bg-gradient-develop rounded-lg flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
        <span class="text-white font-bold text-sm font-mono">CC</span>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base text-primary tracking-tight leading-tight">CurrencieConv</span>
        <span class="text-[10px] text-mute font-mono hidden sm:inline -mt-0.5">by Anuska Rani</span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`text-sm font-medium transition-colors ${
            currentPath === item.href
              ? 'text-link font-semibold'
              : 'text-body hover:text-primary'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language Switcher, Dark Mode Toggle & Mobile Menu -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Dropdown -->
      <div class="relative" id="langDropdownContainer">
        <button
          id="langMenuBtn"
          type="button"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-hairline hover:bg-canvas-soft dark:hover:bg-slate-800 text-xs font-semibold text-primary transition-all"
          title="Select Language"
        >
          <span>{activeLang.flag}</span>
          <span class="uppercase font-mono">{activeLang.code}</span>
          <svg class="w-3 h-3 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          id="langMenuDropdown"
          class="hidden absolute right-0 mt-1 w-36 rounded-xl border border-hairline bg-canvas dark:bg-slate-900 shadow-xl py-1 z-50"
        >
          {languages.map((l) => (
            <a
              href={l.href}
              class={`flex items-center gap-2 px-3 py-2 text-xs font-medium transition-colors hover:bg-link-bg-soft dark:hover:bg-slate-800 ${
                currentLocale === l.code ? 'text-link font-bold' : 'text-primary'
              }`}
            >
              <span>{l.flag}</span>
              <span>{l.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Dark Mode Toggle -->
      <button 
        id="darkModeToggle" 
        class="p-2 hover:bg-canvas-soft dark:hover:bg-slate-800 rounded-lg transition-colors text-primary"
        title="Toggle dark mode"
        aria-label="Toggle dark mode"
      >
        <svg id="sunIcon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l-2.12-2.12a1 1 0 00-1.414 0l-.707.707a1 1 0 000 1.414l2.12 2.12a1 1 0 001.414 0l.707-.707a1 1 0 000-1.414zM2.05 13.464a1 1 0 00-1.414-1.414l-.707.707a1 1 0 000 1.414l.707.707a1 1 0 001.414 0l.707-.707zm12-12a1 1 0 00-1.414 0l-.707.707a1 1 0 000 1.414l.707.707a1 1 0 001.414 0l.707-.707a1 1 0 000-1.414zM10 15a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM4.464 4.465a1 1 0 00-1.414 0L2.343 5.58a1 1 0 000 1.414l1.414 1.414a1 1 0 001.414 0l1.414-1.414a1 1 0 000-1.414z" clip-rule="evenodd"></path>
        </svg>
        <svg id="moonIcon" class="w-5 h-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>

      <button 
        id="mobileMenuBtn"
        class="md:hidden p-2 hover:bg-canvas-soft dark:hover:bg-slate-800 rounded-lg transition-colors text-primary"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-hairline bg-canvas dark:bg-slate-950 px-4 py-3 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
          currentPath === item.href
            ? 'bg-link-bg-soft text-link font-semibold dark:bg-blue-900/30'
            : 'text-body hover:bg-canvas-soft dark:hover:bg-slate-800'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  import { toggleDarkMode, initDarkMode } from '../utils/darkMode';

  initDarkMode();

  const toggleBtn = document.getElementById('darkModeToggle');
  toggleBtn?.addEventListener('click', () => {
    toggleDarkMode();
  });

  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const langBtn = document.getElementById('langMenuBtn');
  const langDropdown = document.getElementById('langMenuDropdown');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });
</script>
