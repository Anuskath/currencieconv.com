---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  currentPath?: string;
  lang?: string;
}

const { currentPath = '/', lang = 'en' } = Astro.props;
const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];

const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;

const navItems = [
  { label: t.nav.converter, href: localePrefix ? `${localePrefix}/` : '/' },
  { label: t.nav.rates, href: '/rates/' },
  { label: t.nav.guides, href: '/guides/' },
  { label: t.nav.widget, href: '/widget/' },
  { label: t.nav.about, href: '/about/' },
  { label: t.nav.contact, href: '/contact/' },
  { label: t.nav.faq, href: '/faq/' },
];

const languages = [
  { code: 'en', label: 'English', flag: '🇺🇸', href: '/' },
  { code: 'es', label: 'Español', flag: '🇪🇸', href: '/es/' },
  { code: 'pt', label: 'Português', flag: '🇧🇷', href: '/pt/' },
  { code: 'fr', label: 'Français', flag: '🇫🇷', href: '/fr/' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪', href: '/de/' },
];

const activeLang = languages.find(l => l.code === currentLocale) || languages[0];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/90 dark:bg-[#0b0d1b]/90 border-b border-[#e3e8ee] dark:border-[#22284c] transition-colors">
  <div class="container-app py-3.5 sm:py-4 flex items-center justify-between">
    <!-- Brand Logo & Icon -->
    <a href={localePrefix || '/'} class="flex items-center gap-3 group text-decoration-none">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#533afd] via-[#665efd] to-[#f96bee] p-0.5 shadow-[0_2px_10px_rgba(83,58,253,0.35)] transition-transform group-hover:scale-105 flex items-center justify-center">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 16V4m0 0L3 8m4-4l4 4"></path>
          <path d="M17 8v12m0 0l4-4m-4 4l-4-4"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-[18px] text-[#0d253d] dark:text-white tracking-[-0.3px] leading-tight font-display">CurrencieConv</span>
          <span class="pill-tag-soft !py-0.5 !px-1.5 !text-[9px] hidden xs:inline">LIVE</span>
        </div>
        <span class="text-[10px] text-[#64748d] dark:text-[#94a3b8] font-mono tracking-wider hidden sm:inline -mt-0.5">by Anuska Rani</span>
      </div>
    </a>

    <!-- Navigation Bar on Mesh -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`text-[14px] font-[400] transition-colors ${
            currentPath === item.href
              ? 'text-[#533afd] dark:text-[#665efd] font-semibold'
              : 'text-[#273951] dark:text-[#cbd5e1] hover:text-[#533afd] dark:hover:text-[#665efd]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language Selector, Dark Mode & Primary Pill Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Dropdown -->
      <div class="relative" id="langDropdownContainer">
        <button
          id="langMenuBtn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#12162e] hover:bg-[#f6f9fc] dark:hover:bg-[#181d38] text-xs font-semibold text-[#0d253d] dark:text-white transition-all cursor-pointer shadow-xs"
          title="Select Language"
        >
          <span>{activeLang.flag}</span>
          <span class="uppercase font-mono text-[11px]">{activeLang.code}</span>
          <svg class="w-3 h-3 text-[#64748d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          id="langMenuDropdown"
          class="hidden absolute right-0 mt-1.5 w-36 rounded-2xl border border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#12162e] shadow-xl py-1.5 z-50"
        >
          {languages.map((l) => (
            <a
              href={l.href}
              class={`flex items-center gap-2 px-3.5 py-2 text-xs font-medium transition-colors hover:bg-[#f6f9fc] dark:hover:bg-[#181d38] ${
                currentLocale === l.code ? 'text-[#533afd] dark:text-[#665efd] font-bold' : 'text-[#0d253d] dark:text-white'
              }`}
            >
              <span>{l.flag}</span>
              <span>{l.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Dark / Light Mode Toggle Button -->
      <button 
        id="darkModeToggle" 
        type="button"
        class="w-9 h-9 rounded-full border border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#12162e] hover:bg-[#f6f9fc] dark:hover:bg-[#181d38] transition-all flex items-center justify-center text-[#0d253d] dark:text-white cursor-pointer shadow-xs active:scale-90"
        title="Toggle dark / light mode"
        aria-label="Toggle dark / light mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="sunIcon" class="w-4 h-4 hidden dark:block text-[#facc15]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="moonIcon" class="w-4 h-4 block dark:hidden text-[#0d253d]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- CTA Primary Pill -->
      <a href="/rates/" class="hidden sm:inline-flex btn-stripe-primary text-xs !py-2 !px-4">
        Live Rates →
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuBtn"
        type="button"
        class="md:hidden p-2 rounded-xl border border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#12162e] hover:bg-[#f6f9fc] dark:hover:bg-[#181d38] transition-colors text-[#0d253d] dark:text-white"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#0b0d1b] px-4 py-3 space-y-1 shadow-lg">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors ${
          currentPath === item.href
            ? 'bg-[#e8e8fd] text-[#533afd] font-semibold dark:bg-[#1c1e54]'
            : 'text-[#273951] dark:text-[#cbd5e1] hover:bg-[#f6f9fc] dark:hover:bg-[#12162e]'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  import { toggleDarkMode, initDarkMode } from '../utils/darkMode';

  initDarkMode();

  const toggleBtn = document.getElementById('darkModeToggle');
  toggleBtn?.addEventListener('click', () => {
    toggleDarkMode();
  });

  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const langBtn = document.getElementById('langMenuBtn');
  const langDropdown = document.getElementById('langMenuDropdown');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });
</script>
