---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  currentPath?: string;
  lang?: string;
}

const { currentPath = '/', lang = 'en' } = Astro.props;
const currentLocale = (lang in translations ? lang : 'en') as Locale;
const t = translations[currentLocale];

const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;

const navItems = [
  { label: t.nav.converter, href: localePrefix ? `${localePrefix}/` : '/' },
  { label: t.nav.rates, href: '/rates/' },
  { label: t.nav.guides, href: '/guides/' },
  { label: t.nav.widget, href: '/widget/' },
  { label: t.nav.about, href: '/about/' },
  { label: t.nav.contact, href: '/contact/' },
  { label: t.nav.faq, href: '/faq/' },
];

const languages = [
  { code: 'en', label: 'English', flag: '🇺🇸', href: '/' },
  { code: 'es', label: 'Español', flag: '🇪🇸', href: '/es/' },
  { code: 'pt', label: 'Português', flag: '🇧🇷', href: '/pt/' },
  { code: 'fr', label: 'Français', flag: '🇫🇷', href: '/fr/' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪', href: '/de/' },
];

const activeLang = languages.find(l => l.code === currentLocale) || languages[0];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#0b0d1b]/80 border-b border-[#e3e8ee] dark:border-[#22284c] transition-colors">
  <div class="container-app py-4 flex items-center justify-between">
    <!-- Logo Wordmark -->
    <a href={localePrefix || '/'} class="flex items-center gap-2.5 group text-decoration-none">
      <div class="w-8 h-8 rounded-lg bg-[#533afd] text-white flex items-center justify-center font-bold text-sm shadow-[0_2px_6px_rgba(83,58,253,0.3)] transition-transform group-hover:scale-105">
        <span class="font-mono tracking-tight font-bold">CC</span>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-[17px] text-[#0d253d] dark:text-white tracking-[-0.26px] leading-tight">CurrencieConv</span>
        <span class="text-[10px] text-[#64748d] dark:text-[#94a3b8] font-mono uppercase tracking-wider hidden sm:inline -mt-0.5">by Anuska Rani</span>
      </div>
    </a>

    <!-- Navigation Bar on Mesh -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-7">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`text-[15px] font-[400] transition-colors ${
            currentPath === item.href
              ? 'text-[#533afd] font-medium'
              : 'text-[#273951] dark:text-[#e2e8f0] hover:text-[#533afd] dark:hover:text-[#665efd]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language Selector, Dark Mode & Primary Pill Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Dropdown -->
      <div class="relative" id="langDropdownContainer">
        <button
          id="langMenuBtn"
          type="button"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full border border-[#e3e8ee] dark:border-[#22284c] hover:bg-[#f6f9fc] dark:hover:bg-[#12162e] text-xs font-semibold text-[#0d253d] dark:text-white transition-all cursor-pointer"
          title="Select Language"
        >
          <span>{activeLang.flag}</span>
          <span class="uppercase font-mono">{activeLang.code}</span>
          <svg class="w-3 h-3 text-[#64748d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          id="langMenuDropdown"
          class="hidden absolute right-0 mt-1.5 w-36 rounded-xl border border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#12162e] shadow-xl py-1.5 z-50"
        >
          {languages.map((l) => (
            <a
              href={l.href}
              class={`flex items-center gap-2 px-3 py-2 text-xs font-medium transition-colors hover:bg-[#f6f9fc] dark:hover:bg-[#181d38] ${
                currentLocale === l.code ? 'text-[#533afd] font-bold' : 'text-[#0d253d] dark:text-white'
              }`}
            >
              <span>{l.flag}</span>
              <span>{l.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Dark Mode Toggle Button -->
      <button 
        id="darkModeToggle" 
        class="p-2 rounded-full border border-[#e3e8ee] dark:border-[#22284c] hover:bg-[#f6f9fc] dark:hover:bg-[#12162e] transition-colors text-[#0d253d] dark:text-white cursor-pointer"
        title="Toggle dark mode"
        aria-label="Toggle dark mode"
      >
        <svg id="sunIcon" class="w-4 h-4 hidden dark:block text-[#665efd]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l-2.12-2.12a1 1 0 00-1.414 0l-.707.707a1 1 0 000 1.414l2.12 2.12a1 1 0 001.414 0l.707-.707a1 1 0 000-1.414zM2.05 13.464a1 1 0 00-1.414-1.414l-.707.707a1 1 0 000 1.414l.707.707a1 1 0 001.414 0l.707-.707zm12-12a1 1 0 00-1.414 0l-.707.707a1 1 0 000 1.414l.707.707a1 1 0 001.414 0l.707-.707a1 1 0 000-1.414zM10 15a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM4.464 4.465a1 1 0 00-1.414 0L2.343 5.58a1 1 0 000 1.414l1.414 1.414a1 1 0 001.414 0l1.414-1.414a1 1 0 000-1.414z" clip-rule="evenodd"></path>
        </svg>
        <svg id="moonIcon" class="w-4 h-4 dark:hidden text-[#0d253d]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>

      <!-- CTA Primary Pill -->
      <a href="/rates/" class="hidden sm:inline-flex btn-stripe-primary text-xs !py-2 !px-4">
        Live Rates →
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuBtn"
        class="md:hidden p-2 rounded-lg border border-[#e3e8ee] dark:border-[#22284c] hover:bg-[#f6f9fc] dark:hover:bg-[#12162e] transition-colors text-[#0d253d] dark:text-white"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-[#e3e8ee] dark:border-[#22284c] bg-white dark:bg-[#0b0d1b] px-4 py-3 space-y-1 shadow-lg">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
          currentPath === item.href
            ? 'bg-[#e8e8fd] text-[#533afd] font-semibold dark:bg-[#1c1e54]'
            : 'text-[#273951] dark:text-[#e2e8f0] hover:bg-[#f6f9fc] dark:hover:bg-[#12162e]'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  import { toggleDarkMode, initDarkMode } from '../utils/darkMode';

  initDarkMode();

  const toggleBtn = document.getElementById('darkModeToggle');
  toggleBtn?.addEventListener('click', () => {
    toggleDarkMode();
  });

  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const langBtn = document.getElementById('langMenuBtn');
  const langDropdown = document.getElementById('langMenuDropdown');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });
</script>
